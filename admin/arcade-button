#!/usr/bin/env python3
"""Turn the arcade box's reset button into an EmulationStation restart.

The button is an RP2040 running admin/pico/code.py. When pressed, it writes
"RESTART-ES" to its USB data serial port (the second ttyACM it exposes; the first
is the CircuitPython REPL). This daemon answers "ACK" at once and then runs
`arcade-admin --yes restart-es --force`. If the Pico gets no ACK within a few
seconds (this daemon isn't running, or the box is wedged) it falls back to a
magic-SysRq reboot by itself.

Runs as the systemd service arcade-button.service (user es). Logs go to the
journal: `journalctl -u arcade-button`.

    arcade-button                       normal operation (finds the Pico itself)
    arcade-button --port /dev/pts/3 --dry-run     testing: no restart happens
"""

import argparse
import glob
import os
import subprocess
import sys
import threading
import time
from pathlib import Path

import serial

PICO_VENDOR = "239a"          # Adafruit's VID, which CircuitPython on the Pico uses
REQUEST = b"RESTART-ES"
RESTART_CMD = ["/usr/local/bin/arcade-admin", "--yes", "restart-es", "--force"]
REBOOT_CMD = ["sudo", "-n", "systemctl", "reboot"]
RESTART_TIMEOUT = 180
COOLDOWN = 10           # ignore presses this long after a restart (ES is still loading)


def log(msg):
    print(msg, flush=True)


def find_data_port():
    """The Pico's data port: the higher-numbered of its two ttyACM interfaces.
    With only the console enabled (boot.py missing), return None rather than
    talking to the REPL."""
    by_device = {}
    for tty in glob.glob("/sys/class/tty/ttyACM*"):
        intf = Path(os.path.realpath(f"{tty}/device"))   # .../usb1/1-7/1-7:1.0
        try:
            if (intf.parent / "idVendor").read_text().strip() != PICO_VENDOR:
                continue
            number = int((intf / "bInterfaceNumber").read_text(), 16)
        except (OSError, ValueError):
            continue
        by_device.setdefault(intf.parent, []).append((number, f"/dev/{Path(tty).name}"))
    for ports in by_device.values():
        if len(ports) >= 2:
            return max(ports)[1]
    return None


class Restarter:
    """Runs one restart at a time in the background, so the serial loop keeps
    answering (a second press during a restart must still get its ACK, or the
    Pico would hard-reboot the box)."""

    def __init__(self, dry_run):
        self.dry_run = dry_run
        self.thread = None
        self.finished_at = 0.0

    def request(self):
        if self.thread and self.thread.is_alive():
            log("button pressed again while restarting; ignoring")
            return
        if time.monotonic() - self.finished_at < COOLDOWN:
            log("button pressed again right after a restart; ignoring")
            return
        self.thread = threading.Thread(target=self._run, daemon=True)
        self.thread.start()

    def _run(self):
        try:
            self._restart()
        finally:
            self.finished_at = time.monotonic()

    def _restart(self):
        log("button pressed: restarting EmulationStation")
        if self.dry_run:
            time.sleep(2)
            log("(dry run) would have run: " + " ".join(RESTART_CMD))
            return
        try:
            result = subprocess.run(RESTART_CMD, stdin=subprocess.DEVNULL,
                                    timeout=RESTART_TIMEOUT)
            if result.returncode == 0:
                log("restart finished")
                return
            log(f"arcade-admin exited with status {result.returncode}")
        except subprocess.TimeoutExpired:
            log(f"arcade-admin took longer than {RESTART_TIMEOUT}s")
        log("rebooting the box instead")
        subprocess.run(REBOOT_CMD, check=False)


def serve(path, restarter):
    with serial.Serial(path, 115200, timeout=1, exclusive=True) as port:
        log(f"listening on {path}")
        buf = b""
        while True:
            # Returns as soon as anything arrives; raises SerialException on unplug.
            buf += port.read(max(1, port.in_waiting))
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if line.strip() == REQUEST:
                    port.write(b"ACK\n")
                    port.flush()
                    restarter.request()
                elif line.strip():
                    log(f"ignoring unexpected message: {line[:80]!r}")
            buf = buf[-256:]


def main():
    p = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    p.add_argument("--port", help="serial device to use instead of finding the Pico")
    p.add_argument("--dry-run", action="store_true", help="acknowledge but don't restart")
    args = p.parse_args()

    restarter = Restarter(args.dry_run)
    waiting_logged = False
    while True:
        path = args.port or find_data_port()
        if path is None:
            if not waiting_logged:
                log("waiting for the Pico's data serial port (is it plugged in, "
                    "with admin/pico/boot.py installed?)")
                waiting_logged = True
            time.sleep(2)
            continue
        waiting_logged = False
        try:
            serve(path, restarter)
        except (serial.SerialException, OSError) as e:
            log(f"lost {path}: {e}")
            time.sleep(2)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
