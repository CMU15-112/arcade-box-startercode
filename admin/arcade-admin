# Locations on the box
# ---------------------------------------------------------------------------

HOME = Path.home()
ROMS = HOME / "RetroPie/roms/cmu_graphics"                 # where enabled games live
DISABLED = HOME / "RetroPie/roms/cmu_graphics-disabled"    # where disabled games live
# ES scans these: one folder per semester, holding symlinks to the enabled games in ROMS.
SEMESTER_ROMS = HOME / "RetroPie/roms/cmu_graphics-semesters"
STUFF = HOME / "stuff"
LAUNCHER = STUFF / "112.sh"
FROZEN = STUFF / "frozen"
ES_SYSTEMS = Path("/etc/emulationstation/es_systems.cfg")
GAMELISTS = Path("/opt/retropie/configs/all/emulationstation/gamelists")   # <system>/gamelist.xml
LEGACY_SYSTEM = "112"      # the single system used before semesters; its gamelist is migrated
OTHER_SYSTEM = "Other"     # menu entry for games without a semester
GIT_SEMESTER_KEY = "arcade.semester"   # stored in each game's .git/config
SSH_DIR = HOME / ".ssh"
SSH_CONFIG = SSH_DIR / "config"
SSH_DEAD = SSH_DIR / "dead"
VENV = "retropie-venv"

ES_BIN = "/opt/retropie/supplementary/emulationstation/emulationstation"
ES_RESTART_FLAG = Path("/tmp/es-restart")
UID = os.getuid()
DESKTOP_ENV = {
    "DISPLAY": ":0",
    "XAUTHORITY": f"/run/user/{UID}/gdm/Xauthority",
    "DBUS_SESSION_BUS_ADDRESS": f"unix:path=/run/user/{UID}/bus",
    "XDG_RUNTIME_DIR": f"/run/user/{UID}",
}

NAME_RE = re.compile(r"^[A-Za-z0-9_-]+$")
GITHUB_RE = re.compile(
    r"^(?:https?://github\.com/|git@github\.com:|ssh://git@github\.com/)?"
    r"([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?$"
)


TERMS = ("Spring", "Summer", "Fall")   # in calendar order
TERM_ALIASES = {"spring": 0, "s": 0, "summer": 1, "su": 1, "m": 1, "fall": 2, "f": 2}
SEMESTER_RE = re.compile(r"^\s*(spring|summer|fall|su|s|m|f)[\s_-]*(\d{4}|\d{2})\s*$", re.I)


@dataclass(frozen=True, order=True)
class Semester:
    """A semester such as Fall 2026. Sorts chronologically."""
    year: int
    term_index: int    # index into TERMS

    @property
    def term(self):
        return TERMS[self.term_index]

    def __str__(self):
        return f"{self.term} {self.year}"

    @property
    def slug(self):
        return f"{self.term.lower()}-{self.year}"

    @classmethod
    def parse(cls, text):
        """Accepts 'Fall 2026', 'fall-2026', 'F26', 'S27', 'M26' / 'Summer 26', ..."""
        m = SEMESTER_RE.match(text or "")
        if not m:
            raise AdminError(f"'{text}' isn't a semester; use e.g. 'Fall 2026', 'Spring 2027', "
                             "'Summer 2027' or F26 / S27 / M27")
        year = int(m.group(2))
        if year < 100:
            year += 2000
        return cls(year, TERM_ALIASES[m.group(1).lower()])

    @classmethod
    def for_date(cls, day):
        """August-December is Fall, January-May is Spring, June-July is Summer."""
        if day.month >= 8:
            return cls(day.year, 2)
        if day.month <= 5:
            return cls(day.year, 0)
        return cls(day.year, 1)

    @classmethod
    def current(cls):
        return cls.for_date(datetime.date.today())


class AdminError(Exception):
    """A problem to report to the admin (no traceback)."""


class Declined(Exception):
    """The admin said no to a confirmation; abandon the operation quietly."""


# ---------------------------------------------------------------------------
# User interaction
# ---------------------------------------------------------------------------

class UI:
    """Plain-text prompts. `assume_yes` answers yes to every confirmation."""

    def __init__(self, assume_yes=False):
        self.assume_yes = assume_yes
        self.interactive = sys.stdin.isatty()

    def info(self, msg=""):
        print(msg, flush=True)

    def warn(self, msg):
        print(f"WARNING: {msg}", flush=True)

    def header(self, title):
        print(f"\n== {title} ==", flush=True)

    def confirm(self, question, default=False, destructive=False):
        if self.assume_yes:
            return True
        if not self.interactive:
            if destructive:
                raise AdminError(f"'{question}' needs confirmation; rerun with --yes")
            return default
        hint = "[Y/n]" if default else "[y/N]"
        while True:
            ans = input(f"{question} {hint} ").strip().lower()
            if not ans:
                return default
            if ans in ("y", "yes"):
                return True
            if ans in ("n", "no"):
                return False

    def ask(self, question, default=None):
        if not self.interactive:
            if default is None:
                raise AdminError(f"'{question}' needs an answer; pass it as an option")
            return default
        suffix = f" [{default}]" if default else ""
        ans = input(f"{question}{suffix}: ").strip()
        return ans or (default or "")

    def choose(self, title, options):
        """options: list of (tag, description). Returns a tag or None."""
        print(f"\n{title}")
        for i, (tag, desc) in enumerate(options, 1):
            print(f"  {i:2}) {tag:<32} {desc}")
        ans = input("Choice (blank to go back): ").strip()
        if ans.isdigit() and 1 <= int(ans) <= len(options):
            return options[int(ans) - 1][0]
        return None

    def pause(self):
        if self.interactive:
            input("\nPress Enter to continue...")

    def clear(self):
        pass


class DialogUI(UI):
    """Uses `dialog` for menus. Everything else stays plain text so command
    output (git, pip, warnings) remains visible on the SSH terminal."""

    def choose(self, title, options):
        cmd = ["dialog", "--stdout", "--title", "arcade-admin", "--menu", title,
               "0", "0", "0"]
        for tag, desc in options:
            cmd += [tag, desc or " "]
        res = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)
        self.clear()
        return res.stdout.strip() if res.returncode == 0 else None

    def clear(self):
        subprocess.run(["clear"])


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def run(cmd, *, cwd=None, env=None, check=True, capture=False, quiet=False):
    """Run a command. Output streams to the terminal unless capture=True."""
    if not quiet and not capture:
        print(f"$ {' '.join(str(c) for c in cmd)}", flush=True)
    full_env = None
    if env:
        full_env = {**os.environ, **env}
    res = subprocess.run(
        [str(c) for c in cmd], cwd=cwd, env=full_env, text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
    )
    if check and res.returncode != 0:
        out = f"\n{res.stdout.strip()}" if capture and res.stdout else ""
        raise AdminError(f"command failed ({res.returncode}): {' '.join(map(str, cmd))}{out}")
    return res


def stamp():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


def backup(path):
    if path.exists():
        dest = path.with_name(f"{path.name}.bak-{stamp()}")
        shutil.copy2(path, dest)
        return dest
    return None


def validate_name(name):
    name = name.removesuffix(".git")
    if not NAME_RE.match(name):
        raise AdminError(f"'{name}' is not a valid game name: use only letters, digits, - and _ "
                         "(112.sh can't handle spaces or other characters)")
    for base in (ROMS, DISABLED):
        if (base / f"{name}.git").exists():
            raise AdminError(f"a game named '{name}' already exists in {base}")
    return name


def parse_github(url):
    m = GITHUB_RE.match(url.strip())
    if not m:
        raise AdminError(f"don't understand repo '{url}'. Use https://github.com/OWNER/REPO, "
                         "git@github.com:OWNER/REPO or OWNER/REPO")
    return m.group(1), m.group(2)


def git_quiet_env():
    return {"GIT_TERMINAL_PROMPT": "0", "GIT_SSH_COMMAND": "ssh -o BatchMode=yes"}


def can_reach(url):
    res = run(["git", "ls-remote", "-q", url, "HEAD"], env=git_quiet_env(),
              check=False, capture=True)
    return res.returncode == 0


