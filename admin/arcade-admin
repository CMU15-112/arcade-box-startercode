            ("unfreeze", "Delete its lock file and resume pulling updates"),
            ("display", "Set the display name in the menu"),
            ("rename", "Rename its folder"),
            ("prepare", "Have uv set up its packages now (so the next launch is instant)"),
            ("enable" if not g.enabled else "disable",
             "Show it in the menu again" if not g.enabled else "Hide it from the menu (keeps files)"),
            ("remove", "Delete it from the box"),
        ]
        choice = ui.choose(f"{g.name}  ({g.system}, {state}, {frozen}, {g.transport})", actions)
        if choice is None:
            return
        ns = argparse.Namespace(game=g.name, games=[g.name], all=False, upgrade=False,
                                display=None, new_name=None, semester=None, version=None)
        handler = {
            "launch": cmd_launch, "semester": cmd_semester, "python": cmd_python, "freeze": cmd_freeze, "unfreeze": cmd_unfreeze,
            "display": cmd_display_name, "rename": cmd_rename, "prepare": cmd_prepare,
            "enable": cmd_enable,
            "disable": cmd_disable, "remove": cmd_remove,
        }[choice]
        if not guarded(ui, handler, ns):
            continue
        ui.pause()
        if choice == "remove" and not g.path.exists():
            return
        if choice == "rename":
            return


def guarded(ui, fn, args):
    """Run a command, reporting errors instead of exiting. Returns False if declined/failed."""
    try:
        fn(ui, args)
        return True
    except Declined:
        ui.info("Cancelled.")
    except AdminError as e:
        ui.info(f"\nERROR: {e}")
    ui.pause()
    return False


def menu(ui):
    while True:
        choice = ui.choose("Arcade box game manager", [
            ("list", "List all games"),
            ("manage", "Manage a game (launch, freeze, rename, disable, remove...)"),
            ("add", "Add a new game from GitHub"),
            ("freeze-all", "Freeze every enabled game that isn't frozen yet"),
            ("restart-es", "Restart EmulationStation"),
            ("quit", "Exit"),
        ])
        if choice in (None, "quit"):
            return
        if choice == "list":
            cmd_list(ui)
            ui.pause()
        elif choice == "manage":
            games = all_games()
            gl = gamelist_info()
            tag = ui.choose("Which game?", [
                (g.name, f"[{g.system}] " + ("[disabled] " if not g.enabled else "")
                 + (gl.get(g.dirname, ("",))[0] or "")
                 + ("  (frozen)" if g.frozen else "")) for g in games])
            if tag:
                game_menu(ui, find_game(tag))
        elif choice == "add":
            ns = argparse.Namespace(url=None, name=None, display=None, key_id=None,
                                    no_launch=False, semester=None)
            if guarded(ui, cmd_add, ns):
                ui.pause()
        elif choice == "freeze-all":
            if guarded(ui, cmd_freeze, argparse.Namespace(all=True, games=[])):
                ui.pause()
        elif choice == "restart-es":
            force = False
            if game_running():
                force = ui.confirm("A game is running on the arcade box. Kill it and restart "
                                   "EmulationStation anyway?")
                if not force:
                    continue
            if guarded(ui, cmd_restart_es, argparse.Namespace(force=force)):
                ui.pause()


