def cmd_list(ui, args=None):
    games = all_games()
    gl = gamelist_info()
    rows = [("NAME", "DISPLAY NAME", "SEMESTER", "STATE", "REPO", "BRANCH", "FROZEN", "VENV",
             "PLAYS")]
    for g in games:
        disp, plays = gl.get(g.dirname, ("", ""))
        sem = g.semester
        rows.append((
            g.name,
            disp if disp and disp != g.name else "-",
            str(sem) if sem else "-",
            "enabled" if g.enabled else "DISABLED",
            g.transport,
            g.branch,
            "yes" if g.frozen else "no",
            "yes" if venv_python(g).exists() else "no",
            plays or "-",
        ))
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]))]
    for r in rows:
        ui.info("  ".join(c.ljust(w) for c, w in zip(r, widths)).rstrip())
    ui.info(f"\n{sum(g.enabled for g in games)} enabled, {sum(not g.enabled for g in games)} disabled.")


def sanity_check(ui, path):
    warnings = []
    if not (path / "main.py").exists():
        warnings.append("no main.py at the top level; 112.sh only ever runs `python3 main.py`")
    req = path / "requirements.txt"
    if not req.exists():
        warnings.append("no requirements.txt; dependencies won't be installed automatically")
    else:
        head = req.read_bytes()[:2]
        if head in (b"\xff\xfe", b"\xfe\xff"):
            ui.info("note: requirements.txt is UTF-16 (pip copes, but it's unusual)")
    bundled = [p.name for p in (path / "cmu_graphics", path / "cmu_graphics.py") if p.exists()]
    if bundled:
        warnings.append(f"repo contains {', '.join(bundled)}, which shadows the pip-installed "
                        "cmu_graphics and usually breaks the game")
    has_exit = False
    for py in path.rglob("*.py"):
        if VENV in py.parts:
            continue
        try:
            if "sys.exit" in py.read_text(errors="ignore"):
                has_exit = True
                break
        except OSError:
            pass
    if not has_exit:
        warnings.append("no sys.exit() found; the game may have no way to quit from the joystick")
    for w in warnings:
        ui.warn(w)
    return warnings


def setup_deploy_key(ui, owner, repo, key_id):
    """Ensure Host alias + key exist and the repo is reachable. Returns the clone URL."""
    alias = f"github-{key_id}"
    users = [g.name for g in all_games() if g.ssh_alias == alias]
    if users:
        raise AdminError(f"key id '{key_id}' is already used by {', '.join(users)} "
                         "(GitHub allows a deploy key on only one repo); pick another --key-id")
    if ssh_has_alias(alias):
        keyfile = ssh_identity(alias)
        ui.info(f"Reusing existing Host {alias} ({keyfile}).")
    else:
        keyfile = SSH_DIR / f"id_ed25519.{key_id}"
        if not keyfile.exists():
            run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", f"arcade-box {key_id}",
                 "-f", keyfile])
        ssh_add_alias(alias, keyfile)
        ui.info(f"Added Host {alias} to {SSH_CONFIG}.")
    if keyfile is None or not Path(f"{keyfile}.pub").exists():
        raise AdminError(f"can't find the public key for {alias}")
    url = f"git@{alias}:{owner}/{repo}.git"
    if can_reach(url):
        return url
    pub = Path(f"{keyfile}.pub").read_text().strip()
    ui.info("\nThe student (or a repo admin) needs to add this deploy key:")
    ui.info(f"  GitHub -> {owner}/{repo} -> Settings -> Deploy keys -> Add deploy key")
    ui.info("  Leave 'Allow write access' UNCHECKED.\n")
    ui.info(pub + "\n")
    if not ui.interactive:
        ui.info("Rerun the same command once the key has been added.")
        sys.exit(3)
    while True:
        ans = input("Press Enter once the key is added to check again (or 'q' to stop here): ")
        if ans.strip().lower() == "q":
            ui.info("Stopped. Rerunning `add` later will reuse this key.")
            raise Declined()
        if can_reach(url):
            ui.info("Key works.")
            return url
        ui.info("Still can't read the repo with that key.")


def cmd_add(ui, args):
    url_in = args.url or ui.ask("GitHub repo URL")
    owner, repo = parse_github(url_in)
    default_name = re.sub(r"[^A-Za-z0-9_-]+", "-", repo).strip("-") or "Game"
    name = validate_name(args.name or ui.ask("Game folder name", default_name))
    semester = Semester.parse(args.semester or ui.ask(
        "Semester (e.g. Fall 2026, Spring 2027, Summer 2027)", str(Semester.current())))
    dest = ROMS / f"{name}.git"

    ui.header(f"Adding {owner}/{repo} as {name} ({semester})")
    https_url = f"https://github.com/{owner}/{repo}.git"
    if can_reach(https_url):
        ui.info("Repo is public; cloning over HTTPS (no key needed).")
        clone_url = https_url
    else:
        ui.info("Repo is private (or doesn't exist); setting up a deploy key.")
        default_id = re.sub(r"[^a-z0-9_-]+", "-", owner.lower()).strip("-")
        key_id = args.key_id or ui.ask("Key id (usually the student's Andrew ID)", default_id)
        if not re.match(r"^[a-z0-9_-]+$", key_id):
            raise AdminError("key id may only contain lowercase letters, digits, - and _")
        clone_url = setup_deploy_key(ui, owner, repo, key_id)

    run(["git", "clone", clone_url, dest], env=git_quiet_env())
    game = Game(name, dest, True)
    game.set_semester(semester)
    sanity_check(ui, dest)

    ui.header("Installing dependencies")
    build_venv(game)

    if not args.no_launch and ui.interactive and ui.confirm(
            "Test-launch it on the arcade screen now?", default=True):
        launch(ui, game)
        if ui.confirm("Did it work (including quitting)? Freeze it now (pins packages, stops pulling updates)?", default=True):
            do_freeze(ui, game)
    elif ui.confirm("Freeze it now without a test launch (pins packages, stops pulling updates)?"):
        do_freeze(ui, game)

    display = args.display
    if display is None and ui.interactive:
        display = ui.ask("Display name in the menu (blank = folder name)", "")
    with es_paused(ui, "Adding the game to the menu"):
        if display:
            set_display_name(ui, game, display)
        sync_menu(ui)
    ui.info(f"\nDone: {name} is installed at {dest}, under {semester} in the menu.")


def launch(ui, game):
    if not game.enabled:
        raise AdminError(f"{game.name} is disabled; enable it first")
    with es_paused(ui, "A test launch"):
        ui.info("Launching on the arcade screen; quit the game to come back here.")
        run([LAUNCHER, game.path], env=DESKTOP_ENV, check=False)


def cmd_launch(ui, args):
    launch(ui, find_game(args.game))


def do_freeze(ui, game):
    pkgs = write_lock(game, game.lock)
    if pkgs is None:
        ui.info(f"SKIP  {game.name}: venv is missing or empty (launch it once first)")
        return False
    ui.info(f"OK    {game.name} -> {game.lock}")
    for line in pkgs.splitlines():
        ui.info(f"        {line}")
    return True


def cmd_freeze(ui, args):
    if args.all:
        games = [g for g in all_games() if g.enabled]
    elif args.games:
        games = [find_game(q) for q in args.games]
    else:
        raise AdminError("name one or more games, or use --all")
    for g in games:
        if g.frozen and not args.all and not ui.confirm(
                f"{g.name} is already frozen. Replace its lock with what's installed now?",
                default=True):
            continue
        do_freeze(ui, g)


def cmd_unfreeze(ui, args):
    g = find_game(args.game)
    if not g.frozen:
        ui.info(f"{g.name} isn't frozen.")
        return
    ui.info(g.lock.read_text())
    if ui.confirm(f"Delete this lock file? {g.name} will then pull from GitHub on every "
                  "launch and get unpinned versions whenever its venv is rebuilt.",
                  destructive=True):
        g.lock.unlink()
        ui.info(f"{g.name} is no longer frozen.")


def set_display_name(ui, game, display):
    with es_paused(ui, "Changing the display name"):
        tree = gamelist_load(game.gamelist)
        entry = gamelist_entry(tree, game.dirname)
        if entry is None:
            entry = ET.SubElement(tree.getroot(), "game")
            ET.SubElement(entry, "path").text = f"./{game.dirname}"
        name_el = entry.find("name")
        if name_el is None:
            name_el = ET.SubElement(entry, "name")
        name_el.text = display
        gamelist_save(tree, game.gamelist)
    ui.info(f"{game.name} now shows as '{display}'.")


def cmd_display_name(ui, args):
    g = find_game(args.game)
    display = args.display or ui.ask("New display name")
    if not display:
        raise AdminError("display name can't be empty")
    set_display_name(ui, g, display)


def cmd_semester(ui, args):
    g = find_game(args.game)
    current = g.semester
    text = args.semester or ui.ask("Semester (e.g. Fall 2026, Spring 2027, Summer 2027)",
                                   str(current or Semester.current()))
    sem = Semester.parse(text)
    if sem != current:
        g.set_semester(sem)
    ui.info(f"{g.name} is tagged {sem}.")
    sync_menu(ui)


def cmd_sync_menu(ui, args):
    plan = plan_menu()
    if not plan:
        ui.info("The menu already matches the games.")
        return
    if args.check:
        for line in plan.describe():
            ui.info(f"  {line}")
        sys.exit(4)
    sync_menu(ui)


def cmd_rename(ui, args):
    g = find_game(args.game)
    new = validate_name(args.new_name or ui.ask(f"New folder name for {g.name}"))
    new_path = g.path.parent / f"{new}.git"
    new_game = Game(new, new_path, g.enabled)

    # The venv hard-codes its path, so it has to be rebuilt. Pin it first so the
    # rebuild reproduces exactly what's installed now.
    tmp_lock = None
    if g.frozen:
        lock = new_game.lock
    else:
        tmp_lock = STUFF / f".rename-{g.dirname}.txt"
        lock = tmp_lock if write_lock(g, tmp_lock) else None

    with es_paused(ui, "Renaming"):
        g.path.rename(new_path)
        if g.frozen:
            g.lock.rename(new_game.lock)
        tree = gamelist_load(g.gamelist)
        entry = gamelist_entry(tree, g.dirname)
        if entry is not None:
            entry.find("path").text = f"./{new_game.dirname}"
            name_el = entry.find("name")
            if name_el is not None and name_el.text == g.name:
                name_el.text = new
            gamelist_save(tree, g.gamelist)
        sync_menu(ui)
    ui.info(f"Renamed {g.name} -> {new}. Rebuilding its venv for the new path...")
    try:
        rebuild_venv(new_game, lock)
    finally:
        if tmp_lock:
            tmp_lock.unlink(missing_ok=True)
    ui.info(f"Done. {new} is ready.")


def move_game(ui, g, enable):
    dest_dir = ROMS if enable else DISABLED
    if g.enabled == enable:
        ui.info(f"{g.name} is already {'enabled' if enable else 'disabled'}.")
        return
    dest_dir.mkdir(parents=True, exist_ok=True)
    if (dest_dir / g.dirname).exists():
        raise AdminError(f"{dest_dir / g.dirname} already exists")
    with es_paused(ui, "Updating the menu"):
        g.path.rename(dest_dir / g.dirname)
        ui.info(f"{g.name} {'enabled' if enable else 'disabled (kept in ' + str(DISABLED) + ')'}.")
        sync_menu(ui)


def cmd_disable(ui, args):
    move_game(ui, find_game(args.game), enable=False)


def cmd_enable(ui, args):
    move_game(ui, find_game(args.game), enable=True)


def cmd_remove(ui, args):
    g = find_game(args.game)
    ui.info(f"This permanently deletes {g.path}"
            + (f" and {g.lock}" if g.frozen else "") + ".")
    if ui.assume_yes:
        pass
    elif not ui.interactive:
        raise AdminError("remove needs confirmation; rerun with --yes")
    elif ui.ask(f"Type the game name ({g.name}) to confirm") != g.name:
        ui.info("Not removed.")
        return

    alias = g.ssh_alias
    gamelist = g.gamelist
    shutil.rmtree(g.path)
    g.lock.unlink(missing_ok=True)
    ui.info(f"Deleted {g.name}.")

    if alias and alias.startswith("github-") and not any(o.ssh_alias == alias for o in all_games()):
        keyfile = ssh_identity(alias)
        ssh_remove_alias(alias)
        ui.info(f"Removed Host {alias} from {SSH_CONFIG}.")
        if keyfile and keyfile.exists():
            SSH_DEAD.mkdir(mode=0o700, exist_ok=True)
            for f in (keyfile, Path(f"{keyfile}.pub")):
                if f.exists():
                    shutil.move(str(f), SSH_DEAD / f.name)
            ui.info(f"Moved its key to {SSH_DEAD}. The student can delete the deploy key on GitHub.")

    try:
        with es_paused(ui, "Removing the game from the menu"):
            tree = gamelist_load(gamelist)
            entry = gamelist_entry(tree, g.dirname)
            if entry is not None:
                tree.getroot().remove(entry)
                gamelist_save(tree, gamelist)
            sync_menu(ui)
    except Declined:
        ui.info("Left the menu alone for now; run `arcade-admin sync-menu` to update it.")


def cmd_restart_es(ui, args=None):
    restart_es(ui, force=getattr(args, "force", False))


def cmd_stop_es(ui, args=None):
    force = getattr(args, "force", False)
    if es_pid() is None:
        if force and game_running():
            kill_games(ui)
        ui.info("EmulationStation isn't running.")
        return
    stop_es(force, ui)
    ui.info("EmulationStation stopped.")


def cmd_start_es(ui, args=None):
    if es_pid() is not None:
        ui.info("EmulationStation is already running.")
        return
    start_es(ui)


