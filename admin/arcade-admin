def cmd_remove(ui, args):
    g = find_game(args.game)
    ui.info(f"This permanently deletes {g.path}"
            + (f" and {g.lock}" if g.frozen else "") + ".")
    if ui.assume_yes:
        pass
    elif not ui.interactive:
        raise AdminError("remove needs confirmation; rerun with --yes")
    elif ui.ask(f"Type the game name ({g.name}) to confirm") != g.name:
        ui.info("Not removed.")
        return

    alias = g.ssh_alias
    gamelist = g.gamelist
    shutil.rmtree(g.path)
    g.lock.unlink(missing_ok=True)
    for bak in FROZEN.glob(f"{glob.escape(g.lock.name)}.bak-*"):
        bak.unlink()
    ui.info(f"Deleted {g.name}.")

    if alias and alias.startswith("github-") and not any(o.ssh_alias == alias for o in all_games()):
        keyfile = ssh_identity(alias)
        ssh_remove_alias(alias)
        ui.info(f"Removed Host {alias} from {SSH_CONFIG}.")
        if keyfile and keyfile.exists():
            SSH_DEAD.mkdir(mode=0o700, exist_ok=True)
            for f in (keyfile, Path(f"{keyfile}.pub")):
                if f.exists():
                    shutil.move(str(f), SSH_DEAD / f.name)
            ui.info(f"Moved its key to {SSH_DEAD}. The student can delete the deploy key on GitHub.")

    try:
        with es_paused(ui, "Removing the game from the menu"):
            tree = gamelist_load(gamelist)
            entry = gamelist_entry(tree, g.dirname)
            if entry is not None:
                tree.getroot().remove(entry)
                gamelist_save(tree, gamelist)
            sync_menu(ui)
    except Declined:
        ui.info("Left the menu alone for now; run `arcade-admin sync-menu` to update it.")


