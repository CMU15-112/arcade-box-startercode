    sync_menu(ui)


def cmd_rename(ui, args):
    g = find_game(args.game)
    new = validate_name(args.new_name or ui.ask(f"New folder name for {g.name}"))
    new_path = g.path.parent / f"{new}.git"
    new_game = Game(new, new_path, g.enabled)

    with es_paused(ui, "Renaming"):
        g.path.rename(new_path)
        if g.frozen:
            g.lock.rename(new_game.lock)
        tree = gamelist_load(g.gamelist)
        entry = gamelist_entry(tree, g.dirname)
        if entry is not None:
            entry.find("path").text = f"./{new_game.dirname}"
            name_el = entry.find("name")
            if name_el is not None and name_el.text == g.name:
                name_el.text = new
            gamelist_save(tree, g.gamelist)
        sync_menu(ui)
    ui.info(f"Renamed {g.name} -> {new}.")


def move_game(ui, g, enable):
    dest_dir = ROMS if enable else DISABLED
    if g.enabled == enable:
        ui.info(f"{g.name} is already {'enabled' if enable else 'disabled'}.")
        return
    dest_dir.mkdir(parents=True, exist_ok=True)
    if (dest_dir / g.dirname).exists():
        raise AdminError(f"{dest_dir / g.dirname} already exists")
    with es_paused(ui, "Updating the menu"):
        g.path.rename(dest_dir / g.dirname)
        ui.info(f"{g.name} {'enabled' if enable else 'disabled (kept in ' + str(DISABLED) + ')'}.")
        sync_menu(ui)


