# Small helpers
# ---------------------------------------------------------------------------

def run(cmd, *, cwd=None, env=None, check=True, capture=False, quiet=False):
    """Run a command. Output streams to the terminal unless capture=True."""
    if not quiet and not capture:
        print(f"$ {' '.join(str(c) for c in cmd)}", flush=True)
    full_env = None
    if env:
        full_env = {**os.environ, **env}
    res = subprocess.run(
        [str(c) for c in cmd], cwd=cwd, env=full_env, text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.STDOUT if capture else None,
    )
    if check and res.returncode != 0:
        out = f"\n{res.stdout.strip()}" if capture and res.stdout else ""
        raise AdminError(f"command failed ({res.returncode}): {' '.join(map(str, cmd))}{out}")
    return res


def stamp():
    return datetime.datetime.now().strftime("%Y%m%d-%H%M%S")


def backup(path):
    if path.exists():
        dest = path.with_name(f"{path.name}.bak-{stamp()}")
        shutil.copy2(path, dest)
        return dest
    return None


def validate_name(name):
    name = name.removesuffix(".git")
    if not NAME_RE.match(name):
        raise AdminError(f"'{name}' is not a valid game name: use only letters, digits, - and _ "
                         "(112.sh can't handle spaces or other characters)")
    for base in (ROMS, DISABLED):
        if (base / f"{name}.git").exists():
            raise AdminError(f"a game named '{name}' already exists in {base}")
    return name


def parse_github(url):
    m = GITHUB_RE.match(url.strip())
    if not m:
        raise AdminError(f"don't understand repo '{url}'. Use https://github.com/OWNER/REPO, "
                         "git@github.com:OWNER/REPO or OWNER/REPO")
    return m.group(1), m.group(2)


def git_quiet_env():
    return {"GIT_TERMINAL_PROMPT": "0", "GIT_SSH_COMMAND": "ssh -o BatchMode=yes"}


def can_reach(url):
    res = run(["git", "ls-remote", "-q", url, "HEAD"], env=git_quiet_env(),
              check=False, capture=True)
    return res.returncode == 0


