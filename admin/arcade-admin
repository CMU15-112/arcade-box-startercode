def game_menu(ui, g):
    while True:
        g = find_game(g.name)   # refresh state after each action
        state = "enabled" if g.enabled else "DISABLED"
        frozen = "frozen" if g.frozen else "not frozen"
        actions = [
            ("launch", "Test-launch on the arcade screen"),
            ("semester", "Set its semester (which menu entry it appears under)"),
            ("freeze", "Freeze (or re-freeze) its current packages and stop pulling updates"),
            ("unfreeze", "Delete its lock file and resume pulling updates"),
            ("display", "Set the display name in the menu"),
            ("rename", "Rename its folder"),
            ("enable" if not g.enabled else "disable",
             "Show it in the menu again" if not g.enabled else "Hide it from the menu (keeps files)"),
            ("remove", "Delete it from the box"),
        ]
        choice = ui.choose(f"{g.name}  ({g.system}, {state}, {frozen}, {g.transport})", actions)
        if choice is None:
            return
        ns = argparse.Namespace(game=g.name, games=[g.name], all=False,
                                display=None, new_name=None, semester=None)
        handler = {
            "launch": cmd_launch, "semester": cmd_semester, "freeze": cmd_freeze, "unfreeze": cmd_unfreeze,
            "display": cmd_display_name, "rename": cmd_rename, "enable": cmd_enable,
            "disable": cmd_disable, "remove": cmd_remove,
        }[choice]
        if not guarded(ui, handler, ns):
            continue
        ui.pause()
        if choice == "remove" and not g.path.exists():
            return
        if choice == "rename":
            return


def guarded(ui, fn, args):
    """Run a command, reporting errors instead of exiting. Returns False if declined/failed."""
    try:
        fn(ui, args)
        return True
    except Declined:
        ui.info("Cancelled.")
    except AdminError as e:
        ui.info(f"\nERROR: {e}")
    ui.pause()
    return False


def menu(ui):
    while True:
        choice = ui.choose("Arcade box game manager", [
            ("list", "List all games"),
            ("manage", "Manage a game (launch, freeze, rename, disable, remove...)"),
            ("add", "Add a new game from GitHub"),
            ("freeze-all", "Freeze every enabled game"),
            ("restart-es", "Restart EmulationStation"),
            ("quit", "Exit"),
        ])
        if choice in (None, "quit"):
            return
        if choice == "list":
            cmd_list(ui)
            ui.pause()
        elif choice == "manage":
            games = all_games()
            gl = gamelist_info()
            tag = ui.choose("Which game?", [
                (g.name, f"[{g.system}] " + ("[disabled] " if not g.enabled else "")
                 + (gl.get(g.dirname, ("",))[0] or "")
                 + ("  (frozen)" if g.frozen else "")) for g in games])
            if tag:
                game_menu(ui, find_game(tag))
        elif choice == "add":
            ns = argparse.Namespace(url=None, name=None, display=None, key_id=None,
                                    no_launch=False, semester=None)
            if guarded(ui, cmd_add, ns):
                ui.pause()
        elif choice == "freeze-all":
            if guarded(ui, cmd_freeze, argparse.Namespace(all=True, games=[])):
                ui.pause()
        elif choice == "restart-es":
            force = False
            if game_running():
                force = ui.confirm("A game is running on the arcade box. Kill it and restart "
                                   "EmulationStation anyway?")
                if not force:
                    continue
            if guarded(ui, cmd_restart_es, argparse.Namespace(force=force)):
                ui.pause()


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="arcade-admin",
        description="Manage student games on the arcade box. Run with no command for a menu.")
    p.add_argument("-y", "--yes", action="store_true", help="answer yes to every confirmation")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("list", help="list games").set_defaults(fn=cmd_list)

    a = sub.add_parser("add", help="add a game from GitHub")
    a.add_argument("url", nargs="?", help="https://github.com/OWNER/REPO, git@github.com:OWNER/REPO or OWNER/REPO")
    a.add_argument("--name", help="folder name (letters, digits, - and _)")
    a.add_argument("--display", help="display name in the menu")
    a.add_argument("--semester", help="e.g. 'Fall 2026' or F26 (default: from today's date)")
    a.add_argument("--key-id", help="deploy-key id for private repos (default: owner)")
    a.add_argument("--no-launch", action="store_true", help="skip the test launch")
    a.set_defaults(fn=cmd_add)

    f = sub.add_parser("freeze", help="pin a game's installed packages and stop pulling its updates")
    f.add_argument("games", nargs="*")
    f.add_argument("--all", action="store_true", help="every enabled game")
    f.set_defaults(fn=cmd_freeze)

    for name, fn, hlp in (("unfreeze", cmd_unfreeze, "delete a game's lock file and resume pulling"),
                          ("launch", cmd_launch, "test-launch a game on the arcade screen"),
                          ("disable", cmd_disable, "hide a game from the menu (keeps files)"),
                          ("enable", cmd_enable, "show a disabled game again"),
                          ("remove", cmd_remove, "delete a game from the box")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("game")
        s.set_defaults(fn=fn)

    d = sub.add_parser("display-name", help="set the name shown in the menu")
    d.add_argument("game")
    d.add_argument("display", nargs="?")
    d.set_defaults(fn=cmd_display_name)

    m = sub.add_parser("semester", help="set the semester a game is listed under")
    m.add_argument("game")
    m.add_argument("semester", nargs="?", help="e.g. 'Fall 2026', 'Spring 2027' or F26 / S27 / M27")
    m.set_defaults(fn=cmd_semester)

    y = sub.add_parser("sync-menu", help="rebuild the per-semester menu entries")
    y.add_argument("--check", action="store_true",
                   help="change nothing; exit 4 if the menu is out of date")
    y.set_defaults(fn=cmd_sync_menu)

    r = sub.add_parser("rename", help="rename a game's folder")
    r.add_argument("game")
    r.add_argument("new_name", nargs="?")
    r.set_defaults(fn=cmd_rename)

    for name, fn, hlp in (("restart-es", cmd_restart_es, "restart EmulationStation"),
                          ("stop-es", cmd_stop_es, "close EmulationStation")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("-f", "--force", action="store_true",
                       help="kill a running game first instead of refusing")
        s.set_defaults(fn=fn)
    sub.add_parser("start-es", help="start EmulationStation on the arcade screen").set_defaults(fn=cmd_start_es)
    return p


def main():
    args = build_parser().parse_args()
    if not ROMS.is_dir():
        sys.exit(f"arcade-admin: {ROMS} not found -- run this on the arcade box as the es user")
    try:
        if args.cmd is None:
            if not sys.stdin.isatty():
                sys.exit("arcade-admin: the menu needs a terminal (use `ssh -t arcade arcade-admin`)")
            ui = DialogUI(args.yes) if shutil.which("dialog") else UI(args.yes)
            menu(ui)
            ui.clear()
        else:
            args.fn(UI(args.yes), args)
    except Declined:
        print("Cancelled.")
        sys.exit(1)
    except AdminError as e:
        sys.exit(f"arcade-admin: {e}")
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
