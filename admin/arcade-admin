def cmd_python(ui, args):
    g = find_game(args.game)
    current = g.python or "system"
    text = args.version or ui.ask("Python version (e.g. 3.14), or 'system' for the box's "
                                  "own Python 3.10", current)
    new = None if text.strip().lower() in ("system", "default", "") else text.strip()
    if new and not PYTHON_RE.match(new):
        raise AdminError(f"'{text}' isn't a Python version like 3.14 or 3.14.1")
    if new == g.python:
        ui.info(f"{g.name} already uses {current}.")
        return
    if new and run([uv(), "python", "find", new], capture=True, check=False).returncode != 0:
        if not ui.confirm(f"Python {new} isn't installed. Install it with uv now?", default=True):
            raise Declined()
        run([uv(), "python", "install", new])
    old = g.python
    g.set_python(new)
    ui.info(f"Setting up {g.name}'s packages on {new or 'the system Python'}...")
    try:
        prepare(g)
    except AdminError:
        g.set_python(old)
        hint = (" Its lock file pins versions made for the old Python; unfreeze it, set "
                "the Python, test it, and freeze it again." if g.frozen else "")
        raise AdminError(f"{g.name}'s packages don't install on {new or 'the system Python'}, "
                         f"so it stays on {current}.{hint}")
    ui.info(f"{g.name} now runs on {'Python ' + new if new else 'the system Python'}. "
            "Test-launch it before leaving it that way.")


