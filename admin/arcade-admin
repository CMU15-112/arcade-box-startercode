def build_parser():
    p = argparse.ArgumentParser(
        prog="arcade-admin",
        description="Manage student games on the arcade box. Run with no command for a menu.")
    p.add_argument("-y", "--yes", action="store_true", help="answer yes to every confirmation")
    sub = p.add_subparsers(dest="cmd")

    sub.add_parser("list", help="list games").set_defaults(fn=cmd_list)

    a = sub.add_parser("add", help="add a game from GitHub")
    a.add_argument("url", nargs="?", help="https://github.com/OWNER/REPO, git@github.com:OWNER/REPO or OWNER/REPO")
    a.add_argument("--name", help="folder name (letters, digits, - and _)")
    a.add_argument("--display", help="display name in the menu")
    a.add_argument("--semester", help="e.g. 'Fall 2026' or F26 (default: from today's date)")
    a.add_argument("--key-id", help="deploy-key id for private repos (default: owner)")
    a.add_argument("--no-launch", action="store_true", help="skip the test launch")
    a.set_defaults(fn=cmd_add)

    f = sub.add_parser("freeze", help="pin the package versions a game runs with and stop pulling its updates")
    f.add_argument("games", nargs="*")
    f.add_argument("--all", action="store_true", help="every enabled game that isn't frozen")
    f.set_defaults(fn=cmd_freeze)

    v = sub.add_parser("prepare", help="have uv set up games' packages now")
    v.add_argument("games", nargs="*")
    v.add_argument("--all", action="store_true", help="every game, enabled or not")
    v.add_argument("-U", "--upgrade", action="store_true",
                   help="re-resolve unpinned requirements to the newest versions")
    v.set_defaults(fn=cmd_prepare)

    for name, fn, hlp in (("unfreeze", cmd_unfreeze, "delete a game's lock file and resume pulling"),
                          ("launch", cmd_launch, "test-launch a game on the arcade screen"),
                          ("disable", cmd_disable, "hide a game from the menu (keeps files)"),
                          ("enable", cmd_enable, "show a disabled game again"),
                          ("remove", cmd_remove, "delete a game from the box")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("game")
        s.set_defaults(fn=fn)

    d = sub.add_parser("display-name", help="set the name shown in the menu")
    d.add_argument("game")
    d.add_argument("display", nargs="?")
    d.set_defaults(fn=cmd_display_name)

    m = sub.add_parser("semester", help="set the semester a game is listed under")
    m.add_argument("game")
    m.add_argument("semester", nargs="?", help="e.g. 'Fall 2026', 'Spring 2027' or F26 / S27 / M27")
    m.set_defaults(fn=cmd_semester)

    py = sub.add_parser("python", help="set the Python version a game runs on")
    py.add_argument("game")
    py.add_argument("version", nargs="?", help="e.g. 3.14, or 'system' for the box's Python 3.10")
    py.set_defaults(fn=cmd_python)

    y = sub.add_parser("sync-menu", help="rebuild the per-semester menu entries")
    y.add_argument("--check", action="store_true",
                   help="change nothing; exit 4 if the menu is out of date")
    y.set_defaults(fn=cmd_sync_menu)

    r = sub.add_parser("rename", help="rename a game's folder")
    r.add_argument("game")
    r.add_argument("new_name", nargs="?")
    r.set_defaults(fn=cmd_rename)

    for name, fn, hlp in (("restart-es", cmd_restart_es, "restart EmulationStation"),
                          ("stop-es", cmd_stop_es, "close EmulationStation")):
        s = sub.add_parser(name, help=hlp)
        s.add_argument("-f", "--force", action="store_true",
                       help="kill a running game first instead of refusing")
        s.set_defaults(fn=fn)
    sub.add_parser("start-es", help="start EmulationStation on the arcade screen").set_defaults(fn=cmd_start_es)
    return p


def main():
    args = build_parser().parse_args()
    if not ROMS.is_dir():
        sys.exit(f"arcade-admin: {ROMS} not found -- run this on the arcade box as the es user")
    try:
        if args.cmd is None:
            if not sys.stdin.isatty():
                sys.exit("arcade-admin: the menu needs a terminal (use `ssh -t arcade arcade-admin`)")
            ui = DialogUI(args.yes) if shutil.which("dialog") else UI(args.yes)
            menu(ui)
            ui.clear()
        else:
            args.fn(UI(args.yes), args)
    except Declined:
        print("Cancelled.")
        sys.exit(1)
    except AdminError as e:
        sys.exit(f"arcade-admin: {e}")
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
