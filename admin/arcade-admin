@dataclass
class Game:
    name: str          # without .git
    path: Path
    enabled: bool

    @property
    def dirname(self):
        return f"{self.name}.git"

    @property
    def lock(self):
        return FROZEN / f"{self.dirname}.txt"

    @property
    def venv(self):
        return self.path / VENV

    @property
    def frozen(self):
        return self.lock.exists()

    def git(self, *args):
        res = run(["git", "-C", self.path, *args], check=False, capture=True)
        return res.stdout.strip() if res.returncode == 0 else ""

    @property
    def semester(self):
        raw = self.git("config", "--get", GIT_SEMESTER_KEY)
        if not raw:
            return None
        try:
            return Semester.parse(raw)
        except AdminError:
            return None

    def set_semester(self, sem):
        run(["git", "-C", self.path, "config", GIT_SEMESTER_KEY, str(sem)], quiet=True)

    @property
    def system(self):
        """The ES system (menu entry) this game appears under."""
        sem = self.semester
        return str(sem) if sem else OTHER_SYSTEM

    @property
    def gamelist(self):
        return GAMELISTS / self.system / "gamelist.xml"

    @property
    def remote(self):
        return self.git("remote", "get-url", "origin")

    @property
    def branch(self):
        return self.git("branch", "--show-current") or "?"

    @property
    def transport(self):
        url = self.remote
        if url.startswith("http"):
            return "https"
        m = re.match(r"^(?:ssh://)?git@([^:/]+)[:/]", url)
        if not m:
            return "?" if url else "(no remote)"
        host = m.group(1)
        return "ssh-default" if host == "github.com" else f"alias:{host}"

    @property
    def ssh_alias(self):
        t = self.transport
        return t.split(":", 1)[1] if t.startswith("alias:") else None


def all_games():
    games = []
    for base, enabled in ((ROMS, True), (DISABLED, False)):
        if base.is_dir():
            for p in sorted(base.iterdir(), key=lambda p: p.name.lower()):
                if p.is_dir() and p.name.endswith(".git"):
                    games.append(Game(p.name[:-4], p, enabled))
    return games


def find_game(query):
    q = query.removesuffix(".git").lower()
    games = all_games()
    exact = [g for g in games if g.name.lower() == q]
    if exact:
        return exact[0]
    pref = [g for g in games if g.name.lower().startswith(q)]
    if len(pref) == 1:
        return pref[0]
    if not pref:
        raise AdminError(f"no game matches '{query}' (try `arcade-admin list`)")
    raise AdminError(f"'{query}' is ambiguous: {', '.join(g.name for g in pref)}")


# ---------------------------------------------------------------------------
# EmulationStation control
# ---------------------------------------------------------------------------

def _pids_where(pred):
    pids = []
    for d in Path("/proc").iterdir():
        if d.name.isdigit() and int(d.name) != os.getpid():
            try:
                if pred(d):
                    pids.append(int(d.name))
            except OSError:
                pass
    return pids


def es_pid():
    pids = _pids_where(lambda d: os.readlink(d / "exe") == ES_BIN)
    return pids[0] if pids else None


def launcher_pids():
    """Processes actually executing 112.sh (`[bash] /home/es/stuff/112.sh GAME`), not
    shells that merely mention it in a longer command line."""
    launcher = str(LAUNCHER).encode()

    def is_launcher(d):
        argv = (d / "cmdline").read_bytes().split(b"\0")
        return launcher in argv[:2]
    return _pids_where(is_launcher)


def _ancestors():
    pids, pid = set(), os.getpid()
    while pid and pid not in pids:
        pids.add(pid)
        pid = _ppid(pid)
    return pids


def game_running():
    return bool(launcher_pids())


def _ppid(pid):
    try:
        stat = Path(f"/proc/{pid}/stat").read_text()
        return int(stat.rsplit(")", 1)[1].split()[1])   # field after "(comm)" state
    except (OSError, ValueError, IndexError):
        return None


def kill_games(ui):
    """Kill every running 112.sh launcher and everything it started (the game)."""
    protected = _ancestors()   # never kill the shell/ssh session running this tool
    roots = set(launcher_pids()) - protected
    if not roots:
        return
    targets = set(roots)
    children = {}
    for d in Path("/proc").iterdir():
        if d.name.isdigit():
            children.setdefault(_ppid(int(d.name)), []).append(int(d.name))
    stack = list(roots)
    while stack:
        for c in children.get(stack.pop(), []):
            if c not in targets and c not in protected:
                targets.add(c)
                stack.append(c)
    ui.info(f"Force-quitting the running game ({len(targets)} process(es))...")
    for sig, wait in ((signal.SIGTERM, 5), (signal.SIGKILL, 2)):
        for pid in targets:
            with contextlib.suppress(ProcessLookupError, PermissionError):
                os.kill(pid, sig)
        for _ in range(wait * 4):
            if not any(Path(f"/proc/{p}").exists() for p in targets):
                return
            time.sleep(0.25)


def stop_es(force=False, ui=None):
    if game_running():
        if not force:
            raise AdminError("a game is running on the arcade box right now; quit it first, "
                             "or use --force to kill it")
        kill_games(ui or UI())
    pid = es_pid()
    if pid is None:
        return
    ES_RESTART_FLAG.unlink(missing_ok=True)   # make the wrapper exit instead of relaunching
    os.kill(pid, signal.SIGTERM)
    for _ in range(30):
        if es_pid() is None:
            return
        time.sleep(0.5)
    os.kill(pid, signal.SIGKILL)
    time.sleep(1)


def start_es(ui):
    if es_pid() is not None:
        return
    subprocess.Popen(
        ["gnome-terminal", "--maximize", "--", "emulationstation"],
        env={**os.environ, **DESKTOP_ENV}, start_new_session=True,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    for _ in range(40):
        if es_pid() is not None:
            ui.info("EmulationStation is running again.")
            return
        time.sleep(0.5)
    ui.warn("EmulationStation did not come back. `sudo reboot` will always restore it.")
    if ui.confirm("Reboot the arcade box now?"):
        run(["sudo", "reboot"], check=False)


def restart_es(ui, force=False):
    if es_pid() is None:
        stop_es(force, ui)   # still clears out a hung game when forced
        ui.info("EmulationStation isn't running; starting it.")
    else:
        ui.info("Restarting EmulationStation...")
        stop_es(force, ui)
    start_es(ui)


@contextlib.contextmanager
def es_paused(ui, why):
    """Close ES for the duration of the block (if it's running), then bring it back."""
    was_running = es_pid() is not None
    if was_running:
        if not ui.confirm(f"{why} needs EmulationStation closed on the arcade screen "
                          "for a moment. Continue?", default=True):
            raise Declined()
        stop_es()
    try:
        yield
    finally:
        if was_running:
            start_es(ui)


# ---------------------------------------------------------------------------
# gamelist.xml (only touch while ES is stopped -- it rewrites the file on exit)
# ---------------------------------------------------------------------------

def gamelist_load(path):
    if path.exists():
        return ET.parse(path)
    return ET.ElementTree(ET.Element("gameList"))


def gamelist_entry(tree, dirname):
    for g in tree.getroot().findall("game"):
        if (g.findtext("path") or "").strip() == f"./{dirname}":
            return g
    return None


def gamelist_save(tree, path):
    assert es_pid() is None, "gamelist edited while EmulationStation is running"
    path.parent.mkdir(parents=True, exist_ok=True)
    backup(path)
    ET.indent(tree, space="\t")
    path.write_text('<?xml version="1.0"?>\n'
                    + ET.tostring(tree.getroot(), encoding="unicode") + "\n")


def our_gamelists():
    """Gamelists of every system arcade-admin manages (or used to), legacy one first."""
    names = [LEGACY_SYSTEM] + [s.findtext("name") for s in our_systems(es_systems_load())]
    names += sorted({g.system for g in all_games()})
    seen, paths = set(), []
    for n in names:
        if n and n not in seen:
            seen.add(n)
            paths.append(GAMELISTS / n / "gamelist.xml")
    return [p for p in paths if p.exists()]


def gamelist_info():
    """{dirname: (display name, playcount)} read-only, safe any time."""
    info = {}
    for path in our_gamelists():
        try:
            for g in gamelist_load(path).getroot().findall("game"):
                p = (g.findtext("path") or "").strip().removeprefix("./")
                info[p] = (g.findtext("name") or "", g.findtext("playcount") or "0")
        except ET.ParseError:
            pass
    return info


# ---------------------------------------------------------------------------
# The menu: one ES system per semester (es_systems.cfg + folders of symlinks)
# ---------------------------------------------------------------------------

def es_systems_load():
    if ES_SYSTEMS.exists():
        return ET.parse(ES_SYSTEMS).getroot()
    return ET.Element("systemList")


def our_systems(root):
    """The <system>s that launch student games (including the legacy '112')."""
    cmd = f"{LAUNCHER} %ROM%"
    return [s for s in root.findall("system") if (s.findtext("command") or "").strip() == cmd]


def system_fields(el):
    return [(c.tag, (c.text or "").strip()) for c in el]


def wanted_systems(games):
    """[(name, folder, [games])] newest semester first, untagged games last."""
    groups = {}
    for g in games:
        if g.enabled:
            groups.setdefault(g.semester, []).append(g)
    order = sorted((s for s in groups if s), reverse=True) + ([None] if None in groups else [])
    return [(str(s) if s else OTHER_SYSTEM,
             SEMESTER_ROMS / (s.slug if s else OTHER_SYSTEM.lower()),
             groups[s]) for s in order]


def system_element(name, folder):
    el = ET.Element("system")
    for tag, text in (("name", name),
                      ("fullname", f"15-112 {name}" if name != OTHER_SYSTEM else "15-112 Games"),
                      ("path", str(folder)),
                      ("extension", ".git"),
                      ("command", f"{LAUNCHER} %ROM%"),
                      ("theme", "112")):
        ET.SubElement(el, tag).text = text
    return el


@dataclass
class MenuPlan:
    """What it takes to make the ES menu match the games' semester tags."""
    link_add: list        # [(link, target)]
    link_remove: list     # [link]
    dir_remove: list      # [folder]
    systems: object       # new es_systems.cfg root, or None if unchanged
    moves: list           # [(game, from_gamelist, to_gamelist)]

    def __bool__(self):
        return bool(self.link_add or self.link_remove or self.dir_remove
                    or self.systems is not None or self.moves)

    def describe(self):
        lines = [f"link   {l.parent.name}/{l.name} -> {t}" for l, t in self.link_add]
        lines += [f"unlink {l.parent.name}/{l.name}" for l in self.link_remove]
        lines += [f"rmdir  {d}" for d in self.dir_remove]
        if self.systems is not None:
            names = [s.findtext("name") for s in our_systems(self.systems)]
            lines.append(f"menu   {ES_SYSTEMS}: {', '.join(names) or '(no game systems)'}")
        lines += [f"move   {g.name}'s gamelist entry {a.parent.name} -> {b.parent.name}"
                  for g, a, b in self.moves]
        return lines

    def apply(self, ui):
        for link in self.link_remove:
            link.unlink()
        for d in self.dir_remove:
            d.rmdir()
        for link, target in self.link_add:
            link.parent.mkdir(parents=True, exist_ok=True)
            if link.is_symlink():
                link.unlink()
            link.symlink_to(target)
        if self.systems is not None:
            ET.indent(self.systems, space="  ")
            tmp = STUFF / f".{ES_SYSTEMS.name}.tmp"
            tmp.write_text('<?xml version="1.0"?>\n'
                           + ET.tostring(self.systems, encoding="unicode") + "\n")
            if ES_SYSTEMS.exists():
                run(["sudo", "-n", "cp", "-p", ES_SYSTEMS, f"{ES_SYSTEMS}.bak-{stamp()}"], quiet=True)
            run(["sudo", "-n", "install", "-D", "-m", "644", "-o", "root", "-g", "root",
                 tmp, ES_SYSTEMS], quiet=True)
            tmp.unlink()
        trees = {}
        for g, src, dst in self.moves:
            for p in (src, dst):
                if p not in trees:
                    trees[p] = gamelist_load(p)
            entry = gamelist_entry(trees[src], g.dirname)
            if entry is None:
                continue
            trees[src].getroot().remove(entry)
            old = gamelist_entry(trees[dst], g.dirname)
            if old is not None:
                trees[dst].getroot().remove(old)
            trees[dst].getroot().append(entry)
        for p, tree in trees.items():
            gamelist_save(tree, p)
        for line in self.describe():
            ui.info(f"  {line}")


def plan_menu():
    games = all_games()
    wanted = wanted_systems(games)

    # Symlinks: SEMESTER_ROMS/<semester>/<Name>.git -> ROMS/<Name>.git
    want_links = {folder / g.dirname: g.path for _, folder, gs in wanted for g in gs}
    have_links = {}
    if SEMESTER_ROMS.is_dir():
        for d in SEMESTER_ROMS.iterdir():
            if d.is_dir() and not d.is_symlink():
                for l in d.iterdir():
                    if l.is_symlink():
                        have_links[l] = Path(os.readlink(l))
    link_add = [(l, t) for l, t in sorted(want_links.items()) if have_links.get(l) != t]
    link_remove = sorted(l for l in have_links if l not in want_links)
    want_dirs = {folder for _, folder, _ in wanted}
    dir_remove = []
    if SEMESTER_ROMS.is_dir():
        for d in sorted(SEMESTER_ROMS.iterdir()):
            if (d.is_dir() and not d.is_symlink() and d not in want_dirs
                    and all(c in link_remove for c in d.iterdir())):
                dir_remove.append(d)

    # es_systems.cfg: our systems, newest first, at the top of the list
    root = es_systems_load()
    current = our_systems(root)
    want_els = [system_element(name, folder) for name, folder, _ in wanted]
    in_place = list(root)[:len(current)] == current
    systems = None
    if not in_place or [system_fields(e) for e in current] != [system_fields(e) for e in want_els]:
        for s in current:
            root.remove(s)
        for i, el in enumerate(want_els):
            root.insert(i, el)
        systems = root

    # Gamelist entries (display name, play count) follow the game to its system
    moves = []
    lists = our_gamelists()
    loaded = {p: gamelist_load(p) for p in lists}
    for g in games:
        for p in lists:
            if p != g.gamelist and gamelist_entry(loaded[p], g.dirname) is not None:
                moves.append((g, p, g.gamelist))
    return MenuPlan(link_add, link_remove, dir_remove, systems, moves)


def sync_menu(ui):
    """Make the ES menu match the games. Closes ES for a moment if anything changes,
    since ES reads es_systems.cfg and scans for games only when it starts."""
    if not plan_menu():
        return False
    with es_paused(ui, "Updating the menu"):
        plan = plan_menu()     # again: ES may have saved gamelists while closing
        if plan:
            ui.info("Updating the menu:")
            plan.apply(ui)
    return True


# ---------------------------------------------------------------------------
# ~/.ssh/config
# ---------------------------------------------------------------------------

def ssh_blocks():
    """List of (hosts, lines). The leading chunk before any Host has hosts=[]."""
    blocks = [([], [])]
    if SSH_CONFIG.exists():
        for line in SSH_CONFIG.read_text().splitlines(keepends=True):
            m = re.match(r"^\s*Host\s+(.+)$", line, re.IGNORECASE)
            if m:
                blocks.append((m.group(1).split(), [line]))
            else:
                blocks[-1][1].append(line)
    return blocks


def ssh_identity(alias):
    for hosts, lines in ssh_blocks():
        if alias in hosts:
            for line in lines:
                m = re.match(r"^\s*IdentityFile\s+(.+?)\s*$", line, re.IGNORECASE)
                if m:
                    return Path(os.path.expanduser(m.group(1)))
            return None
    return None


def ssh_has_alias(alias):
    return any(alias in hosts for hosts, _ in ssh_blocks())


def ssh_add_alias(alias, keyfile):
    backup(SSH_CONFIG)
    text = SSH_CONFIG.read_text() if SSH_CONFIG.exists() else ""
    if text and not text.endswith("\n"):
        text += "\n"
    text += f"\nHost {alias}\n\tHostname github.com\n\tUser git\n\tIdentityFile {keyfile}\n"
    SSH_CONFIG.write_text(text)


def ssh_remove_alias(alias):
    blocks = ssh_blocks()
    kept = [b for b in blocks if b[0] != [alias]]
    if len(kept) == len(blocks):
        return False
    backup(SSH_CONFIG)
    SSH_CONFIG.write_text("".join("".join(lines) for _, lines in kept).rstrip("\n") + "\n")
    return True


# ---------------------------------------------------------------------------
# Virtual environments and lock files
# ---------------------------------------------------------------------------

def venv_python(game):
    return game.venv / "bin" / "python"


def pip_freeze(game):
    py = venv_python(game)
    if not py.exists():
        return None
    res = run([py, "-m", "pip", "freeze", "--exclude-editable"], capture=True, check=False)
    if res.returncode != 0:
        raise AdminError(f"pip freeze failed for {game.name}:\n{res.stdout}")
    return res.stdout.strip()


def write_lock(game, dest):
    pkgs = pip_freeze(game)
    if not pkgs:
        return None
    FROZEN.mkdir(parents=True, exist_ok=True)
    today = datetime.date.today().isoformat()
    dest.write_text(f"# Frozen {today} from {game.dirname}/{VENV} by arcade-admin\n{pkgs}\n")
    return pkgs


def pip_install(game, *args):
    run([venv_python(game), "-m", "pip", "install", "--disable-pip-version-check", *args],
        cwd=game.path)


def build_venv(game):
    """Same dependency steps as 112.sh."""
    if not game.venv.exists():
        run(["python3", "-m", "venv", game.venv])
    req = game.path / "requirements.txt"
    if game.frozen:
        pip_install(game, "-r", game.lock)
        if req.exists():
            pip_install(game, "-r", req, "-c", game.lock)
    elif req.exists():
        pip_install(game, "-r", req)


def rebuild_venv(game, lock):
    shutil.rmtree(game.venv, ignore_errors=True)
    run(["python3", "-m", "venv", game.venv])
    if lock:
        pip_install(game, "-r", lock)
    else:
        build_venv(game)


